{
  "rules": {
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['geohash','activityType','joinable','updatedAt'])"
      }
    },

    "liveSessions": {
      "$sessionId": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('ownerId').val() === auth.uid) || (data.exists() && data.child('ownerId').val() === auth.uid))",
        ".validate": "newData.hasChildren(['ownerId','visibility','activityType','startedAt'])"
      }
    },

    "sessionMembers": {
      "$sessionId": {
        ".read": "auth != null && (root.child('liveSessions').child($sessionId).child('ownerId').val() === auth.uid || data.child(auth.uid).val() === true)",
        ".write": false
      }
    },

    "preciseSessionLocation": {
      "$sessionId": {
        ".read": "auth != null && (root.child('liveSessions').child($sessionId).child('ownerId').val() === auth.uid || root.child('sessionMembers').child($sessionId).child(auth.uid).val() === true)",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (root.child('liveSessions').child($sessionId).child('ownerId').val() === auth.uid || root.child('sessionMembers').child($sessionId).child(auth.uid).val() === true)",
          ".validate": "newData.hasChildren(['latitude','longitude','updatedAt'])"
        }
      }
    }
  }
}